{
  "name": "vorzai-ecommerce",
  "version": "0.2.5",
  "private": true,
  "description": "Vorzai 电商 Agent — 跨平台电商智能体桌面应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:dev": "node scripts/start-dev.js",
    "dev": "vite",
    "dev:server": "tsx server/src/index.ts",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:full": "concurrently -k -n VITE,SERVER,ELECTRON -c blue,green,magenta \"vite\" \"tsx server/src/index.ts\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:electron": "tsc -p server/tsconfig.json && tsc && vite build && electron-builder",
    "package": "electron-builder",
    "build:web": "tsc && vite build --mode web",
    "build:icons": "node scripts/build-logo.js",
    "build:release": "bash scripts/build-release.sh",
    "build:release:patch": "bash scripts/build-release.sh --bump=patch",
    "build:release:minor": "bash scripts/build-release.sh --bump=minor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server/src",
    "test": "vitest run",
    "test:server": "vitest run server/tests/",
    "test:smoke": "vitest run --grep smoke",
    "test:regression": "vitest run --grep regression",
    "test:coverage": "vitest run --coverage",
    "keys:generate": "bash scripts/generate-keys.sh",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:db:list": "node scripts/backup-db.mjs --list",
    "repo:init": "bash scripts/repo-setup.sh",
    "gitee:sync": "bash scripts/gitee-sync.sh"
  },
  "build": {
    "appId": "com.vorzai.ecommerce",
    "productName": "Vorzai 电商 Agent",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/dist/**/*",
      "server/src/db/schema.sql"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "vorzai-ecommerce Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "language": "2052"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0",
    "zod": "^3.22.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
